---
import { getCollection } from 'astro:content';

// sort posts, first by gen and if gen is equal then by chapter
const posts = (await getCollection('sims')).sort(
    (a, b) => {
      if (a.data.generation !== b.data.generation) {
        return b.data.generation - a.data.generation;
      }
      return b.data.chapter - a.data.chapter;
    }
);

const currentPost = posts.findIndex((post) => post.id === Astro.params.id);
const prevPost = currentPost + 1 === posts.length ? null : posts[currentPost + 1];
const nextPost = currentPost === 0 ? null : posts[currentPost - 1];
---
{
  (prevPost || nextPost) && (
    <div class="pb-5 navbuttons">
      { prevPost && ( <span class="float-start mb-3"><a href={`/basilio/${prevPost.id}/`}>&larr; {prevPost.data.generation}.{prevPost.data.chapter}: {prevPost.data.title}</a></span> ) }
      { nextPost && ( <span class="float-end mb-3"><a href={`/basilio/${nextPost.id}/`}>{nextPost.data.generation}.{nextPost.data.chapter}: {nextPost.data.title} &rarr;</a></span> ) }
    </div>
  )
}