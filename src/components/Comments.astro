---
// lovingly based on https://virtualobserver.moe/ayano/comment-widget :-) just for my own db and not goople. awesome resource to use though if you want something like this!

const { apiURL = "https://comments-api.lastsunrise.art" } = Astro.props;

// extract postId from the URL path for the sake of proper uploads
const postId =
    Astro.url.pathname
        .split("/")
        .filter((segment) => segment.length > 0)
        .pop() || "unknown-post";
---

<section class="comments-section" data-post-id={postId} style="border:none">
    <h3>Comments</h3>

    <form class="row g-3" id="comment-form">
        <div class="form-group col-12 col-lg-6">
            <label class="form-label" for="author-name">Name *</label>
            <input
                class="form-control"
                type="text"
                id="author-name"
                name="authorName"
                placeholder="Your name"
                required
            />
        </div>

        <div class="form-group col-12 col-lg-6">
            <label class="form-label" for="author-url">Website (optional)</label
            >
            <input
                class="form-control"
                type="url"
                id="author-link"
                name="authorLink"
                placeholder="yoursite.com"
            />
        </div>

        <div class="form-group">
            <label class="form-label" for="comment-content">Comment *</label>
            <textarea
                class="form-control"
                id="comment-content"
                name="content"
                placeholder="Share your thoughts..."
                required></textarea>
        </div>

        <button class="col-auto btn p-2" type="submit" id="submit-btn"
            >Submit Comment</button
        >
        <div id="form-message" class="form-message"></div>
    </form>
    <hr>

    <div id="comments-container">
        <p>Loading...</p>
    </div>
</section>

<script define:vars={{ postId, apiURL }}>
    let isSubmitting = false;

    document.addEventListener("DOMContentLoaded", () => {
        console.log("Using postId:", postId); // DEBUG
        loadComments();
        setupForm();
    });

    // note to self: despite the fact that astro docs say you don't need async tags, you do in fact need them
    async function loadComments() {
        try {
            // grab comments
            const response = await fetch(`${apiURL}/comments/${postId}`);

            // convert to json
            const data = await response.json();

            // error check
            if (data.success) {
                displayComments(data.comments); // show the comments
            } else {
                showError("Failed to load comments"); // show error message
            }
        } catch (error) {
            // more detailed errors oooo
            console.error("Failed to load comments:", error);
            showError("Failed to load comments");
        }
    }

    // actually render comments
    function displayComments(comments) {
        const container = document.getElementById("comments-container");

        // no comments check
        if (comments.length === 0) {
            container.innerHTML =
                "<p>Nothing here yet, want to be the first?</p>";
            return;
        }

        // convert every object to html and then join all that html
        container.innerHTML = comments
            .map(
                (comment) => `
                    <article class="comment lightgradient px-3 py-1 mb-3">
                        <div class="comment-header mt-2">
                        <span class="comment-author">
                            ${comment.author_link
                                ? `<a href="${escapeHtml(comment.author_link)}" target="_blank" rel="noopener noreferrer">${escapeHtml(comment.author_name)}</a>`
                                : escapeHtml(comment.author_name)}
                        </span>
                        <span class="comment-date">${formatDate(comment.created_at)}</span>
                        </div>
                        <p class="comment-content">${escapeHtml(comment.content)}</p>
                    </article>
                `,
            )
            .join("");
    }

    function setupForm() {
        // All of The Elements.
        const form = document.getElementById("comment-form");
        const submitBtn = document.getElementById("submit-btn");

        // wait very patiently for submit button click
        form.addEventListener("submit", async (e) => {
            e.preventDefault(); // no spam refreshes
            if (isSubmitting) return; // or double clicks

            // generate keys n values for db
            const formData = new FormData(form);
            const authorName = formData.get("authorName").trim();
            const authorLink = formData.get("authorLink").trim();
            const content = formData.get("content").trim();

            // check if author name is empty
            if (!authorName || !content) {
                showMessage("Please fill in all required fields.", "error");
                return;
            }

            // loading state
            isSubmitting = true;
            submitBtn.disabled = true; // disable submit button
            submitBtn.textContent = "Submitting...";
            hideMessage(); // clear any previous messages

            try {
                // POST to db
                const response = await fetch(`${apiURL}/comments`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    // convert form data to JSON
                    body: JSON.stringify({
                        postId,
                        authorName,
                        authorLink: authorLink || null,
                        content,
                        siteOrigin: window.location.hostname,
                    }),
                });

                // parse response
                const data = await response.json();

                if (data.success) {
                    showMessage("Comment submitted successfully!", "success");
                    form.reset(); // clear form fields

                    // reload comments after 2 secs to display the new one :-)
                    setTimeout(() => {
                        loadComments();
                        hideMessage();
                    }, 2000);
                } else {
                    showMessage(
                        data.error || "Failed to submit comment",
                        "error",
                    );
                }
            } catch (error) {
                console.error("Failed to submit comment:", error);
                showMessage(
                    "Failed to submit comment. Please try again.",
                    "error",
                );
            } finally {
                // reset load state
                isSubmitting = false;
                submitBtn.disabled = false;
                submitBtn.textContent = "Submit Comment";
            }
        });
    }

    // show messages
    function showMessage(message, type) {
        const messageDiv = document.getElementById("form-message");
        messageDiv.textContent = message;
        messageDiv.className = `form-message ${type}`; // css inject
    }

    // hide messages
    function hideMessage() {
        const messageDiv = document.getElementById("form-message");
        messageDiv.style.display = "none";
    }

    // security
    function escapeHtml(unsafe) {
        return unsafe
            .replace(/&/g, "&amp;") // & becomes &amp;
            .replace(/</g, "&lt;") // < becomes &lt;
            .replace(/>/g, "&gt;") // > becomes &gt;
            .replace(/"/g, "&quot;") // " becomes &quot;
            .replace(/'/g, "&#039;"); // ' becomes &#039;
    }

    // reformat dates
    function formatDate(dateString) {
        const date = new Date(dateString);

        return date.toLocaleDateString("en-US", {
            year: "numeric", // 2024
            month: "short", // Jan, Feb, etc.
            day: "numeric", // 1, 2, 3, etc.
            hour: "2-digit", // 01, 02, etc.
            minute: "2-digit", // 01, 02, etc.
        });
    }
</script>
